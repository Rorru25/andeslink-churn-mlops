{
  "id": null,
  "uid": "andeslink-api-monitoring",
  "title": "AndesLink API Monitoring",
  "tags": ["andeslink", "mlops", "fastapi", "prometheus"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "API disponible",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "up{job=\"andeslink-api\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Modelo cargado",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "andeslink_model_loaded",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests totales",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(andeslink_api_requests_total)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Predicciones totales",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(andeslink_predictions_total)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests por segundo",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(andeslink_api_requests_total[1m]))",
          "refId": "A",
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latencia p95",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(andeslink_api_request_latency_seconds_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Predicciones por clase",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (prediction) (andeslink_predictions_total)",
          "refId": "A",
          "legendFormat": "prediction {{prediction}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Predicciones por nivel de riesgo",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (risk_level) (andeslink_predictions_total)",
          "refId": "A",
          "legendFormat": "{{risk_level}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Errores de inferencia",
      "gridPos": {"h": 5, "w": 8, "x": 0, "y": 21},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(andeslink_prediction_errors_total)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Probabilidad promedio de churn",
      "gridPos": {"h": 5, "w": 8, "x": 8, "y": 21},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(andeslink_prediction_probability_sum) / sum(andeslink_prediction_probability_count)",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Errores HTTP 4xx/5xx",
      "gridPos": {"h": 5, "w": 8, "x": 16, "y": 21},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(andeslink_api_requests_total{http_status=~\"4..|5..\"})",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        }
      }
    }
  ]
}
